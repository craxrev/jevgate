{
  "hooks": {
    "PreToolUse": [
      { "matcher": "Bash",  "hooks": [{ "type": "command", "command": "node", "args": ["--no-warnings", "${CLAUDE_PLUGIN_ROOT}/hooks/bash-gate.ts"],  "timeout": 10 }] },
      { "matcher": "Agent", "hooks": [{ "type": "command", "command": "node", "args": ["--no-warnings", "${CLAUDE_PLUGIN_ROOT}/hooks/agent-gate.ts"], "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node", "args": ["--no-warnings", "${CLAUDE_PLUGIN_ROOT}/hooks/done-check.ts"], "timeout": 30 }] }
    ]
  },
  "modules": ["./compact.ts"]
}
