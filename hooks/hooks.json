{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/warn.sh"], "timeout": 5 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|MultiEdit|NotebookEdit|Read",
        "hooks": [{ "type": "command", "command": "sh", "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/answer.sh"], "timeout": 5 }]
      }
    ]
  },
  "modules": ["./compact.ts"]
}
